# Both are required for Resend email (locally and on Vercel → Production env → redeploy).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
CONTACT_TO_EMAIL=you@example.com
# Optional: set a verified sender in your Resend account/domain
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# Hero: replace public/hero-bg.mp4 with a mobile + web UI loop (see public/videos/README.txt).

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder
# Server-only — never expose to the browser or NEXT_PUBLIC_* vars.
